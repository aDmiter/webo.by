generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id             Int      @id @default(1)
  siteName       String   @default("WEBO.by")
  tagline        String   @default("Студия web-разработки")
  colorBackground String  @default("#ffffff") @map("color_background")
  colorPrimary   String   @default("#03ccbd") @map("color_primary")
  colorAccent    String   @default("#ff6b4a") @map("color_accent")
  colorForeground String  @default("#0f172a") @map("color_foreground")
  contactEmail   String   @default("hello@webo.by") @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  contactAddress String?  @map("contact_address")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   @db.Text
  description String   @db.Text
  content     String?  @db.Text
  imageUrl    String?  @map("image_url")
  projectUrl  String?  @map("project_url")
  tags        String?  @db.Text
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("portfolio_items")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text
  coverUrl    String?   @map("cover_url")
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}
